    <element xsi:type="archimate:Goal" id="id-5605875814fe4a2da9373d8d0343775e"/>
    <element xsi:type="archimate:Assessment" name="Riesgo crítico: incapacidad de demostrar la autorización del titular" id="id-66bc6bd5c67d45cf8e87e5118700b70a"/>
    <element xsi:type="archimate:Goal" name="Gobernar las bases críticas de datos personales: lograr que clientes, arrendatarios y propietarios tengan sus atributos clasificados, un responsable identificable y una referencia verificable a la autorización" id="id-58ae05661ed74d129a385db24d918606"/>
    <element xsi:type="archimate:Goal" name="Localizar rápidamente los atributos: identificar dónde residen los datos cuando se recibe una solicitud de un titular o una auditoría" id="id-fbfb2561c9a043d1b5a054eb971a7e95"/>
    <element xsi:type="archimate:Outcome" name="Inventario y diccionario de datos consultable y trazable, con clasificación, responsables, metadatos de negocio y técnicos, y referencia localizable a la evidencia de autorización" id="id-56558180b7634c9c9304aa1d05cd9340"/>
    <element xsi:type="archimate:Requirement" name="Interfaz usable por personal de negocio y no solo técnicInterfaz usable por personal de negocio y no solo técnico" id="id-b3d8f82688c344a283489b4e0c9fec76"/>
    <element xsi:type="archimate:Requirement" name="Historial auditable de quién cambió qué y por qué" id="id-ef5705f7d3ef4f0c9b05eda1e9957055"/>
    <element xsi:type="archimate:Requirement" name="Capacidad de localizar y ayudar a demostrar la autorización" id="id-def0dca935d7423b82a5946e0a4ace25"/>
    <element xsi:type="archimate:Requirement" name="Reutilización de los datos existentes, evitando la redigitación" id="id-b56a40a368594a548e56d5c08ba1f8fb"/>
    <element xsi:type="archimate:Requirement" name="Protección de la información personal" id="id-95f2f5a2dffa42de8d70ec3e7c51e5de"/>
    <element xsi:type="archimate:Principle" name="Autorización antes que uso" id="id-43359cf8f9404681a2ed50e27aaf09d7"/>
    <element xsi:type="archimate:Principle" name="Aplicar el criterio más restrictivo cuando exista duda" id="id-97457fb4c31646228befaac168d691ef"/>
    <element xsi:type="archimate:Principle" name="Un responsable claro por dato" id="id-e9ea9aea8376470bb710eb0feb091ca0"/>
    <element xsi:type="archimate:Principle" name="Principle" id="id-cdc8207f90ea4dcfb40bde7595c053d3"/>
    <element xsi:type="archimate:Principle" name="Jurídica tiene la última palabra en la interpretación" id="id-c90ded06b49a4538af2d17dc36a038d6"/>
    <element xsi:type="archimate:Constraint" name="No reemplazar Arrendax ni Nido en el corto plazo" id="id-813f31d9f4714b1db048e0139a5e2cdc"/>
    <element xsi:type="archimate:Constraint" name="La retención no está definida; por ahora, solo se documenta" id="id-cc3e785ce90c4e8a8b0309c65ef65e43"/>
    <element xsi:type="archimate:Constraint" name="Los sistemas fuente se consultan en modo de solo lectura" id="id-adae63bc3eb24325ae660fe38c6165c8"/>
    <element xsi:type="archimate:Constraint" name="Los datos almacenados en celulares y WhatsApp quedan fuera del MVP; el riesgo debe documentarse" id="id-8b1b11f9d9124ace9afaa1631ee0b0a4"/>
