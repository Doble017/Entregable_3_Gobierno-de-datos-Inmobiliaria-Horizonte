  <folder name="Motivation" id="id-24c5dc5525c44db893ff680814233475" type="motivation">
    <element xsi:type="archimate:Meaning" name="Información del escenario asociada a una persona; la interpretación legal concreta debe validarla Jurídica." id="id-05790257ca514a45bbbf15e6917dcc74"/>
    <element xsi:type="archimate:Meaning" name="Responsabilidad de gobierno atribuida al jefe del área que recoge o usa el dato, distinta de la custodia técnica." id="id-6785e42f4b98445989152c6877d644fd"/>
    <element xsi:type="archimate:Meaning" name="Estado o referencia localizable a evidencia relacionada con recolección o tratamiento; no demuestra por sí sola suficiencia legal." id="id-483a26b2b70a4aeda49c713c6386749c"/>
    <element xsi:type="archimate:Meaning" name="Registro manual consolidado de bases y atributos en el estado actual; no equivale al Diccionario objetivo." id="id-c982bc52713d48dbaea6e44bae56ffc6"/>
    <element xsi:type="archimate:Meaning" name="Significado de “Cliente” en Comercial: pendiente de definición con el área." id="id-ac5abf6105fa4af0b1865fe368e999fe"/>
    <element xsi:type="archimate:Meaning" name="Inventario gobernado de bases, atributos, responsables y fuentes." id="id-d2c698988b9e4e47808f82a7e41ed0ea"/>
    <element xsi:type="archimate:Meaning" name="Persona a quien se refiere el dato o la solicitud, según el vocabulario del proyecto." id="id-c662f16df4c449d28f6ecb0fb112403a"/>
    <element xsi:type="archimate:Meaning" name="Registro de bases de datos ante la SIC mencionado en la entrevista; Jurídica tramita su actualización." id="id-cb954cc09e4e4e6489be59f8f0ca009e"/>
    <element xsi:type="archimate:Meaning" name="Término usado en la entrevista para el canal o proceso de reclamos de titulares; no es el nombre de la aplicación." id="id-3a3020d531164387846db1d412b276c5"/>
  </folder>
